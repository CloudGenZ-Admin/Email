# Server Configuration
PORT=3000
NODE_ENV=production

# SMTP Configuration (PurelyMail)
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notification@cloudgenz.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM_EMAIL=notification@cloudgenz.com

# Global BCC (comma-separated if multiple)
DEFAULT_BCC=cloudgenz.it@gmail.com

# Default Timezone
DEFAULT_TIMEZONE=America/Toronto

# Rate Limiting (per IP per day per form)
RATE_LIMIT_PER_DAY=2

# CORS Allowed Origins (* for all or comma-separated list)
CORS_ORIGIN=*

# Trust Proxy (set true when running behind Nginx / Cloudflare)
TRUST_PROXY=true

# MySQL Database Configuration (Sequelize)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloudgenz_forms
DB_USER=your_db_username
DB_PASSWORD=your_db_password
